.DS_Store
.venv/
__pycache__/
.pytest_cache/
*.py[cod]

# Local settings and credentials
.env
.env.*
!.env.example
*.pem
*.key

# Local AI/research-assistant runtime; not part of the study deliverables
/.agents/

# Generated research data
/data/processed/*
!/data/processed/README.md
/data/annotations/private/
/data/annotations/**/items_with_text.*
/data/annotations/**/*author_identifier*

# Run results, models, reports and local exports
/results/*
!/results/README.md
*.ckpt
*.pt
*.pth
*.onnx
*.safetensors
/mlruns/
/wandb/

# Notebook caches
.ipynb_checkpoints/

# Local copies of papers may be copyrighted; track metadata and notes instead
/papers/
/literature/papers/*.pdf
/literature/papers/*.caj
!/literature/papers/README.md

# Literature reading notes are personal working documents
/literature/notes/
